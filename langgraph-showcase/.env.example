# Deterministic mode (default, "true") uses symbolic fallbacks — no model
# calls, no Ollama/vLLM backend required at all, safe to leave everything
# below unset for a first run. Set to "false" to make all 11 agents call a
# real LLM backend (also switches the ASK tab and embeddings to LLM-backed).
SKIP_LLM=true

# Only required when SKIP_LLM=false. Inside docker compose the app talks to
# the llm-gateway service (OpenAI /v1 proxy). Override only if you bypass
# the gateway (host venv → Ollama directly, or Cloud Run → LM Studio/vLLM).
#   Compose default:              http://llm-gateway:4000/v1
#   Host venv / direct Ollama:    http://localhost:11434/v1
#   Direct LM Studio / vLLM:      http://host.docker.internal:1234/v1
LLM_BASE_URL=http://llm-gateway:4000/v1

# API key for the OpenAI-compatible hop. Compose llm-gateway requires this
# to match LITELLM_MASTER_KEY (default sk-micro-cosmos-local). Direct Ollama
# ignores auth — any non-empty value works.
LLM_API_KEY=sk-micro-cosmos-local

# Compose: "gateway" (app → llm-gateway → one backend). Host venv without
# the proxy: ollama | lmstudio | vllm | vertex. Switching Ollama vs LM Studio
# vs Bedrock vs Vertex vs vLLM *through the proxy* is LLM_PROFILE, not this.
LLM_ENGINE=gateway

# Gateway backend profile (ollama active; others dormant until you switch).
# Change LLM_PROFILE and restart only llm-gateway — no silent failover.
LLM_PROFILE=ollama

# Vertex AI — OPTIONAL. Prefer LLM_PROFILE=vertex on llm-gateway (app stays
# LLM_ENGINE=gateway). Direct app-side Vertex (bypass proxy) still needs:
#   1. LLM_ENGINE=vertex
#   2. ADC (`gcloud auth application-default login`) + quota project
#   3. Un-comment the ~/.config/gcloud bind mount on micro-cosmos
# See transferable-skills/memory/vertex-ai-engine-support.md.
#LLM_ENGINE=vertex
GOOGLE_GENAI_USE_VERTEXAI=FALSE
#GOOGLE_CLOUD_PROJECT=your-project-id
#GOOGLE_CLOUD_LOCATION=europe-west2

# Sampling temperature (0.0–2.0). Leave unset to use the model's own default.
MODEL_TEMPERATURE=0.2

# Required when SKIP_LLM=false — the model name(s) your backend serves.
# Local Ollama baseline on this machine: gemma4:latest
# (For LLM_ENGINE=vertex instead, use a real Gemini model ID enabled in your
# project's Model Garden — e.g. gemini-2.5-flash — not an Ollama tag or an
# LM Studio-style path; MODEL_CONTEXT_LENGTH is ignored for that engine.)
MODEL_REASONING=gemma4:latest
MODEL_FAST=gemma4:latest
MODEL_CONTEXT_LENGTH=131072

# Max Code Writer/review retry attempts per seam before the TDD loop moves
# on to the next seam (default: 3). A seam that hits this cap is marked
# "failed" (still gets its best-effort code packaged) and gets exactly one
# more focused retry attempt after every seam has been processed once.
MAX_TDD_ITERATIONS_PER_SEAM=3

# Optional — web UI
# WEB_HOST=0.0.0.0
# WEB_PORT=8080
