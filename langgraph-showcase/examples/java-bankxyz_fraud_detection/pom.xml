<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
           https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- Last Spring Boot release with Java 8 LTS support -->
    <version>2.7.18</version>
    <relativePath/>
  </parent>

  <groupId>com.bankxyz.fraud</groupId>
  <artifactId>bankxyz-fraud-detection</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>BankXYZ Fraud Detection</name>
  <description>
    Java 8 / Spring Boot migration of the BankXYZ COBOL/CICS/Db2/MQ fraud detection estate.
    CICS programs → Spring @Service beans (SOA RPC via direct method calls).
    Db2 embedded SQL → Spring Data JPA + Oracle 10g dialect.
    IBM MQ → Spring JMS / ActiveMQ (same queue names; swap broker in application.properties).
    JCL FDBATCH01 → Spring Batch job triggered by scheduler or REST endpoint.
  </description>

  <properties>
    <java.version>1.8</java.version>
    <!-- Spring Boot 2.7.18 manages junit-jupiter 5.8.2 / junit-platform 1.8.2.
         Bumped to the last JUnit 5 line that still targets Java 8 bytecode so that
         cucumber-junit-platform-engine's @Suite / junit-platform-suite support works
         (that needs junit-platform-suite-engine, stabilised in platform 1.9+).
         JUnit 6.x requires Java 17 and must NOT be pulled in here. -->
    <junit-jupiter.version>5.10.2</junit-jupiter.version>
    <cucumber.version>7.18.1</cucumber.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit-jupiter.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-bom</artifactId>
        <version>${cucumber.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>

    <!-- Web / REST — replaces EXEC CICS LINK from CAAUTH to FDRTCHK -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- JPA / Hibernate — replaces Db2 embedded SQL (EXEC SQL ... END-EXEC) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Spring Batch — replaces JCL FDBATCH01 nightly job -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-batch</artifactId>
    </dependency>

    <!-- Spring JMS + ActiveMQ — replaces IBM MQ 9.3 / FRAUD.ALERT.QUEUE.
         To use the real IBM MQ, swap this for com.ibm.mq:mq-jms-spring-boot-starter
         and update application.properties with ibm.mq.* properties. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-activemq</artifactId>
    </dependency>

    <!-- Oracle JDBC driver.
         Oracle 10g native driver (ojdbc14) is not in Maven Central.
         To use it: mvn install:install-file -Dfile=ojdbc14.jar \
           -DgroupId=com.oracle -DartifactId=ojdbc14 -Dversion=10.2.0.5 -Dpackaging=jar
         Then replace this dependency with com.oracle:ojdbc14:10.2.0.5.
         ojdbc8 below works for basic connectivity to Oracle 10.x. -->
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc8</artifactId>
      <version>21.9.0.0</version>
    </dependency>

    <!-- Jackson — replaces STRING concatenation JSON in FDNOTIFY (CHG-2019-0088) -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- Actuator — health / metrics endpoints -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.batch</groupId>
      <artifactId>spring-batch-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- H2 — in-memory stand-in for Oracle 10g in the test/BDD suite only.
         Production always uses Oracle (see application.properties); H2 keeps
         `mvn test` self-contained so it runs inside the Docker build with no
         external Oracle/ActiveMQ containers required. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Cucumber BDD — https://cucumber.io/docs/tools/java/ -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-spring</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- Runs the JUnit Platform suite (RunCucumberTest) — standard Maven test phase -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/RunCucumberTest.java</include>
            <include>**/*Test.java</include>
          </includes>
          <systemPropertyVariables>
            <cucumber.junit-platform.naming-strategy>long</cucumber.junit-platform.naming-strategy>
            <cucumber.publish.quiet>true</cucumber.publish.quiet>
            <spring.profiles.active>test</spring.profiles.active>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <!-- Coverage report — target/site/jacoco/index.html.
           `mvn verify` fails the build if line coverage on the business logic
           (service/web/domain — the fraud-scoring engine, REST endpoint and
           domain state machines) drops below 90%. Entities, DTOs, repository
           interfaces and Spring @Configuration classes are deliberately
           excluded: they carry no branching logic of their own to protect,
           and adding tests whose only purpose is exercising a getter/setter
           is not worth the maintenance cost. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.11</version>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <includes>
                    <include>com.bankxyz.fraud.service.*</include>
                    <include>com.bankxyz.fraud.web.*</include>
                    <include>com.bankxyz.fraud.domain.*</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.85</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
